<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 需要 Windows SDK 投影：读「系统媒体会话」判断视频到底在播还是在暂停，
         不再用切换式媒体键瞎猜（用户手动暂停过就会反过来） -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WatchVideoPlugin</AssemblyName>
    <RootNamespace>WatchVideoPlugin</RootNamespace>
    <Version>1.0.0.0</Version>
    <!-- WinRT 投影是「仅引用」包，类库默认不会把 Microsoft.Windows.SDK.NET.dll /
         WinRT.Runtime.dll 复制到输出目录。插件是运行时动态加载的，
         缺了这两个 dll 会在第一次调用媒体会话时抛 FileNotFoundException（实测踩过）。
         所以强制把依赖复制到输出，部署时一起放进 plugins/watchvideo/。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LolClientToolbox.Contracts\LolClientToolbox.Contracts.csproj" />
  </ItemGroup>

</Project>
