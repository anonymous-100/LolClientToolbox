<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 需要 Windows SDK 投影：读「系统媒体会话」判断视频到底在播还是在暂停，
         不再用切换式媒体键瞎猜（用户手动暂停过就会反过来） -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WatchVideoPlugin</AssemblyName>
    <RootNamespace>WatchVideoPlugin</RootNamespace>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LolClientToolbox.Contracts\LolClientToolbox.Contracts.csproj" />
  </ItemGroup>

</Project>
